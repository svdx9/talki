{
  "name": "talki",
  "version": "0.0.1",
  "private": true,
  "description": "Real-time language learning platform",
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "build": "pnpm -r build",
    "lint": "biome check --max-warnings=0",
    "lint:fix": "biome check --write",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "lefthook": "^1.11.0"
  }
}
